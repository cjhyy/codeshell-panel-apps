{
  "schemaVersion": 2,
  "id": "quant-lab",
  "version": "0.51.0",
  "title": {
    "default": "投资工作台",
    "en": "Investment Desk",
    "zh-CN": "投资工作台"
  },
  "description": "A local-first investment desk for market and stock diagnosis, portfolio tracking, alerts, news, and research.",
  "entry": "app/index.html",
  "icon": "line-chart",
  "placement": "right-dock",
  "singleton": true,
  "permissions": [
    "context.session",
    "context.workspace",
    "workspace.info",
    "workspace.read",
    "workspace.write",
    "external.open",
    "storage",
    "agent.submitPrompt",
    "agent.task",
    "automations.manage",
    "notifications.send",
    "process",
    "resources",
    "background.services"
  ],
  "agent": {
    "tools": [
      {
        "name": "get_portfolio_context",
        "description": "Read the current workspace portfolio ledger fingerprint, accounts, positions and opening-import sources before adding holdings. Does not read brokerage accounts.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "import_portfolio_snapshot",
        "description": "Preview or atomically import confirmed Shanghai/Shenzhen stock holdings into an empty account as opening positions. Preserves source/date, refuses duplicate account imports and changed ledgers, refreshes and verifies the panel after commit. No orders or brokerage operations.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "preview",
                "commit"
              ]
            },
            "expectedFingerprint": {
              "type": [
                "string",
                "null"
              ],
              "description": "Exact fingerprint from get_portfolio_context; null only when no ledger exists."
            },
            "account": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "broker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "id",
                "name",
                "broker"
              ],
              "additionalProperties": false
            },
            "valuationDate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "description": "Opening ledger date YYYY-MM-DD. Use source date when known; otherwise an explicitly chosen recording date, never an invented trade date."
            },
            "source": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "marketDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Actual date shown by source, or null if unknown."
                }
              },
              "required": [
                "reference",
                "marketDate"
              ],
              "additionalProperties": false
            },
            "positions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8,
                    "pattern": "^[A-Z]{2}[0-9]{6}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "quantity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Actual share quantity as a decimal string."
                  },
                  "costBasis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Total position cost in CNY, not cost per share."
                  },
                  "marketValue": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Source snapshot position value in CNY, not current quote."
                  }
                },
                "required": [
                  "symbol",
                  "name",
                  "quantity",
                  "costBasis",
                  "marketValue"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "expectedFingerprint",
            "account",
            "valuationDate",
            "source",
            "positions"
          ],
          "additionalProperties": false
        },
        "readOnly": false
      }
    ],
    "skills": [
      "agent/skills/investment-research/SKILL.md",
      "agent/skills/portfolio-management/SKILL.md",
      "agent/skills/project-runtime/SKILL.md"
    ]
  },
  "backgroundServices": {
    "market-feed": {
      "entry": "quant-market-service",
      "channels": {
        "quotes": {
          "maxBytes": 262144
        }
      },
      "maxLifetimeMs": 21600000,
      "idleGraceMs": 60000
    }
  },
  "nativeEntries": {
    "fetch-holding-quotes": {
      "entry": "app/tools/fetch-holding-quotes.mjs",
      "sha256": "c2c2963d1ce1811c77b14508fcda14f0a72873bb541839b85eb4f76829057606"
    },
    "build-market-pulse": {
      "entry": "app/tools/build-market-pulse.mjs",
      "sha256": "7790403b1a5b864009cc1520187c8947d21ad993e3c9a278fc299c10808630ba"
    },
    "build-a-share-selection": {
      "entry": "app/tools/build-a-share-selection.mjs",
      "sha256": "9f7235099786c39a276912b468cf1a83f10d85b8ecbfa1989694b9dde404fc20"
    },
    "fetch-us-stock": {
      "entry": "app/tools/fetch-us-stock.mjs",
      "sha256": "1cec57dc9651dd7d619699291693994221c84f125358de7798254f40abd9cb5c"
    },
    "fetch-a-share-stock": {
      "entry": "app/tools/fetch-a-share-stock.mjs",
      "sha256": "dfc93d7552eb38e61c587d73ea514b1ddf20b8f97f93e051e4dd7f4314184301"
    },
    "fetch-market-data": {
      "entry": "app/tools/fetch-market-data.mjs",
      "sha256": "141d0ec7b9c7eeb57d79451d81342cf48e3843b025b5282521f1516a253ca7da"
    },
    "initialize-a-share-history": {
      "entry": "app/tools/initialize-a-share-history.mjs",
      "sha256": "5f4812996bc537c293c41fd3acba0d70121d44a369700c863b1f8b02f5a54d53"
    },
    "quant-market-service": {
      "entry": "app/tools/market-service.mjs",
      "sha256": "21df5348247a65640e26d816548fe50b51189021013105e52ee1f1a776753a47"
    },
    "quant-history-batch": {
      "entry": "app/tools/history-batch.mjs",
      "sha256": "f5d6aaef2a4b473e7d8fc1bf2cbe1e02454692b1162feaaa684838201d099878"
    }
  }
}
