{
  "schemaVersion": 2,
  "id": "quant-lab",
  "version": "0.50.0",
  "title": {
    "default": "投资工作台",
    "en": "Investment Desk",
    "zh-CN": "投资工作台"
  },
  "description": "A local-first investment desk for market and stock diagnosis, portfolio tracking, alerts, news, and research.",
  "entry": "app/index.html",
  "icon": "line-chart",
  "placement": "right-dock",
  "singleton": true,
  "permissions": [
    "context.session",
    "context.workspace",
    "workspace.info",
    "workspace.read",
    "workspace.write",
    "external.open",
    "storage",
    "agent.submitPrompt",
    "agent.task",
    "automations.manage",
    "notifications.send",
    "process",
    "background.services"
  ],
  "agent": {
    "tools": [
      {
        "name": "get_portfolio_context",
        "description": "Read the current workspace portfolio ledger fingerprint, accounts, positions and opening-import sources before adding holdings. Does not read brokerage accounts.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "import_portfolio_snapshot",
        "description": "Preview or atomically import confirmed Shanghai/Shenzhen stock holdings into an empty account as opening positions. Preserves source/date, refuses duplicate account imports and changed ledgers, refreshes and verifies the panel after commit. No orders or brokerage operations.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "preview",
                "commit"
              ]
            },
            "expectedFingerprint": {
              "type": [
                "string",
                "null"
              ],
              "description": "Exact fingerprint from get_portfolio_context; null only when no ledger exists."
            },
            "account": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "broker": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "id",
                "name",
                "broker"
              ],
              "additionalProperties": false
            },
            "valuationDate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10,
              "description": "Opening ledger date YYYY-MM-DD. Use source date when known; otherwise an explicitly chosen recording date, never an invented trade date."
            },
            "source": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                "marketDate": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Actual date shown by source, or null if unknown."
                }
              },
              "required": [
                "reference",
                "marketDate"
              ],
              "additionalProperties": false
            },
            "positions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "properties": {
                  "symbol": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8,
                    "pattern": "^[A-Z]{2}[0-9]{6}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "quantity": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Actual share quantity as a decimal string."
                  },
                  "costBasis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Total position cost in CNY, not cost per share."
                  },
                  "marketValue": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 16,
                    "description": "Source snapshot position value in CNY, not current quote."
                  }
                },
                "required": [
                  "symbol",
                  "name",
                  "quantity",
                  "costBasis",
                  "marketValue"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "mode",
            "expectedFingerprint",
            "account",
            "valuationDate",
            "source",
            "positions"
          ],
          "additionalProperties": false
        },
        "readOnly": false
      }
    ],
    "skills": [
      "agent/skills/investment-research/SKILL.md",
      "agent/skills/portfolio-management/SKILL.md",
      "agent/skills/project-runtime/SKILL.md"
    ]
  },
  "backgroundServices": {
    "market-feed": {
      "entry": "quant-market-service",
      "channels": {
        "quotes": {
          "maxBytes": 262144
        }
      },
      "maxLifetimeMs": 21600000,
      "idleGraceMs": 60000
    }
  },
  "nativeEntries": {
    "fetch-holding-quotes": {
      "entry": "app/tools/fetch-holding-quotes.mjs",
      "sha256": "79675b510646d70d8fde2c15c26ddf46c0b5a8fb527ed57996e0cc89398e8826"
    },
    "build-market-pulse": {
      "entry": "app/tools/build-market-pulse.mjs",
      "sha256": "c04ea588277b4e65d275b3d870fc94f4e29d039bd54cd5cfd66c5959eacef723"
    },
    "build-a-share-selection": {
      "entry": "app/tools/build-a-share-selection.mjs",
      "sha256": "f60dd64b2e3eb1a306be737f5d3f2e6bbab22b5f07445af64e02390afc34a9e5"
    },
    "fetch-us-stock": {
      "entry": "app/tools/fetch-us-stock.mjs",
      "sha256": "eb537644832fe7e8812fe1097a61d4effa03c1f49b1198caf4f7b6c099b7ccbb"
    },
    "fetch-a-share-stock": {
      "entry": "app/tools/fetch-a-share-stock.mjs",
      "sha256": "ea6e54c1707c95549a2b9be0a3bf9df17ce8afcaa4ddc7b64177ac4aa5c54d02"
    },
    "fetch-market-data": {
      "entry": "app/tools/fetch-market-data.mjs",
      "sha256": "141d0ec7b9c7eeb57d79451d81342cf48e3843b025b5282521f1516a253ca7da"
    },
    "initialize-a-share-history": {
      "entry": "app/tools/initialize-a-share-history.mjs",
      "sha256": "9cd922512956f6477d229e9421bc58197bdeaa7b6c61795188ec189a7a976f05"
    },
    "quant-market-service": {
      "entry": "app/tools/market-service.mjs",
      "sha256": "d26865e81fd4124492ffa8ac9ad8478e5b0dc25bcc751779f72f251085a0af25"
    },
    "quant-history-batch": {
      "entry": "app/tools/history-batch.mjs",
      "sha256": "7dffecc49075d0143caa379fcfe0b6fb7ffee945e56ba602f19fe0045420440a"
    }
  }
}
