{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeshell.dev/schemas/job-hunt-panel-v2.schema.json",
  "title": "Job Hunt HQ project snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "profile",
    "jobs",
    "repos",
    "experiences",
    "jobResearch",
    "workflowRuns",
    "resume",
    "versions",
    "interviewSets",
    "preparationPlans",
    "interviewDebriefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "updatedAt": {
      "type": "string"
    },
    "selectedJobId": {
      "type": "string"
    },
    "selectedInterviewSetId": {
      "type": "string"
    },
    "profile": {
      "type": "object"
    },
    "jobs": {
      "type": "array"
    },
    "repos": {
      "type": "array"
    },
    "experiences": {
      "type": "array"
    },
    "jobResearch": {
      "type": "array"
    },
    "workflowRuns": {
      "type": "array"
    },
    "resume": {
      "type": "object"
    },
    "versions": {
      "type": "array"
    },
    "interviewSets": {
      "type": "array"
    },
    "preparationPlans": {
      "type": "array"
    },
    "interviewDebriefs": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
