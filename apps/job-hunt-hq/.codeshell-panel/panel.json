{
  "schemaVersion": 2,
  "id": "job-hunt-hq",
  "version": "1.25.0",
  "title": {
    "default": "Job Hunt HQ",
    "en": "Job Hunt HQ",
    "zh-CN": "求职作战室"
  },
  "description": "Bind a dedicated career-data workspace, verify profile, experience, repository evidence, Base Resume and job sources, then turn selected JDs into traceable job-search artifacts in the current Session.",
  "entry": "app/index.html",
  "icon": "layout-dashboard",
  "placement": "right-dock",
  "singleton": true,
  "permissions": [
    "context.session",
    "context.workspace",
    "workspace.info",
    "workspace.read",
    "workspace.write",
    "storage",
    "external.open",
    "agent.submitPrompt",
    "credentials.cookies",
    "automations.manage"
  ],
  "agent": {
    "tools": [
      {
        "name": "get_job_search_context",
        "description": "Read the active project binding, candidate evidence, optional target JDs, resume versions, interview intelligence, preparation plans, question sets, and interview debriefs.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "report_execution_trace",
        "description": "Record one meaningful source, stage, or warning in the active Panel execution trace. Use this sparingly for observable milestones, not hidden reasoning or narration.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "event_type": {
              "type": "string",
              "enum": ["source", "stage", "warning"]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "detail": {
              "type": "string",
              "maxLength": 1000
            },
            "source_refs": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            }
          },
          "required": ["event_type", "label", "source_refs"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "complete_execution_trace",
        "description": "Finish the active Panel execution trace with an explicit outcome summary, final status, and output references after useful structured writes are complete.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": ["completed", "partial", "failed"]
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "output_refs": {
              "description": "Opaque IDs, source locators, or short artifact references produced by this run.",
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "error": {
              "description": "Concise blocking error or unresolved failure when status is failed or partial.",
              "type": "string",
              "maxLength": 2000
            }
          },
          "required": ["trace_id", "status", "summary", "output_refs"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_channel_verification",
        "description": "Save the visible-browser access and login result for exactly one recruiting provider in the current Session. CodeShell owns the persistent browser profile; this tool never receives credentials, cookies, or verification codes.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "provider_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "description": "Exact built-in or custom provider id from get_job_search_context.providerCatalog."
            },
            "status": {
              "type": "string",
              "enum": ["ready", "login_required", "captcha_required", "blocked", "unavailable"]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": ["provider_id", "status", "detail"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_jd_intake_results",
        "description": "Save explicit recognition outcomes for pasted text, screenshots, PDFs, documents, chat exports, or files from the project JD inbox. Every processed source must become imported, needs_review, duplicate, or failed instead of existing only as a Trace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "results": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "intake_id": { "type": "string", "maxLength": 100 },
                  "source_path": { "type": "string", "minLength": 1, "maxLength": 1000 },
                  "original_name": { "type": "string", "minLength": 1, "maxLength": 240 },
                  "source_kind": {
                    "type": "string",
                    "enum": ["pasted_text", "image", "pdf", "document", "file", "project_file", "project_scan", "chat_export"]
                  },
                  "status": {
                    "type": "string",
                    "enum": ["imported", "needs_review", "duplicate", "failed"]
                  },
                  "summary": { "type": "string", "maxLength": 2000 },
                  "job_ids": {
                    "type": "array",
                    "maxItems": 20,
                    "items": { "type": "string", "minLength": 1, "maxLength": 100 }
                  },
                  "error": { "type": "string", "maxLength": 2000 }
                },
                "required": ["source_path", "original_name", "source_kind", "status", "summary", "job_ids"],
                "additionalProperties": false
              }
            }
          },
          "required": ["results"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_candidate_context",
        "description": "Save candidate profile, project evidence, and work history extracted from the active CodeShell project's verified files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "profile": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "role": {
                  "type": "string",
                  "maxLength": 120
                },
                "contact": {
                  "type": "string",
                  "maxLength": 300
                },
                "target": {
                  "type": "string",
                  "maxLength": 500
                },
                "summary": {
                  "type": "string",
                  "maxLength": 3000
                }
              },
              "additionalProperties": false
            },
            "repositories": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "tech": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  }
                },
                "required": ["name", "summary"],
                "additionalProperties": false
              }
            },
            "work_history": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "period": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "achievements": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                },
                "required": ["company", "role"],
                "additionalProperties": false
              }
            }
          },
          "required": ["profile", "repositories", "work_history"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_job_opportunities",
        "description": "Save discovered job records through a strict completeness gate. Listing cards and partial descriptions become jobLeads and never count as formal opportunities; only a full JD with substantive responsibilities and requirements enters the triage jobs pool and is written to career-data/jd/jobs/.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "jobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "source_id": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "employment_type": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "jd_completeness": {
                    "type": "string",
                    "enum": ["full", "partial", "listing_only"]
                  },
                  "verification_notes": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "fetched_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "match": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": ["company", "title"],
                "additionalProperties": false
              }
            }
          },
          "required": ["jobs"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "update_application_progress",
        "description": "Update one job's triage or application stage, next action, reminder date, and evidence-based progress note while preserving an append-only timeline. Only move an inbox job to saved when the user explicitly expresses interest.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": [
                "inbox",
                "saved",
                "tailoring",
                "applied",
                "screening",
                "interviewing",
                "offer",
                "rejected",
                "withdrawn",
                "archived"
              ]
            },
            "note": {
              "type": "string",
              "maxLength": 2000
            },
            "next_action": {
              "type": "string",
              "maxLength": 500
            },
            "next_action_at": {
              "type": "string",
              "maxLength": 80
            },
            "occurred_at": {
              "type": "string",
              "maxLength": 80
            }
          },
          "required": ["job_id", "status"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_workflow_progress",
        "description": "Create or update the current session's job-hunt workflow progress so the project-bound panel can visualize long-running work.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "workflow_id": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": ["running", "completed", "partial", "failed"]
            },
            "current_step": {
              "type": "string",
              "enum": [
                "discover",
                "verify-jd",
                "company",
                "reviews",
                "interviews",
                "resume",
                "prepare",
                "debrief",
                "artifacts"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            },
            "steps": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "running", "completed", "skipped", "failed"]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": ["id", "status"],
                "additionalProperties": false
              }
            }
          },
          "required": ["status", "current_step"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_job_research",
        "description": "Save sourced company facts, public review summaries, interview intelligence, risks, and source records for one saved job.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "company": {
              "type": "object",
              "properties": {
                "official_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "website": {
                  "type": "string",
                  "maxLength": 1000
                },
                "careers_url": {
                  "type": "string",
                  "maxLength": 1000
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000
                },
                "industry": {
                  "type": "string",
                  "maxLength": 200
                },
                "stage": {
                  "type": "string",
                  "maxLength": 200
                },
                "size": {
                  "type": "string",
                  "maxLength": 200
                },
                "locations": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "products": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "tech_signals": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "hiring_signals": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "required": ["official_name", "summary"],
              "additionalProperties": false
            },
            "reviews": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "sentiment": {
                    "type": "string",
                    "enum": ["positive", "mixed", "negative", "unknown"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  },
                  "pros": {
                    "type": "array",
                    "maxItems": 15,
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "cons": {
                    "type": "array",
                    "maxItems": 15,
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                  }
                },
                "required": ["source", "sentiment", "summary", "confidence"],
                "additionalProperties": false
              }
            },
            "interview_intel": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "maxLength": 5000
                },
                "process": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "themes": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "questions": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "properties": {
                      "question": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 1000
                      },
                      "category": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "origin": {
                        "type": "string",
                        "enum": ["reported", "predicted"]
                      },
                      "source_url": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": ["question", "origin"],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "risks": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["official", "job", "review", "interview", "news", "other"]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "publisher": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "accessed_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["kind", "title", "url", "accessed_at"],
                "additionalProperties": false
              }
            }
          },
          "required": ["job_id", "company", "reviews", "interview_intel", "risks", "sources"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_interview_question_set",
        "description": "Save an evidence-grounded interview question set derived from a JD, verified candidate materials, or substantive Git commits.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "job_id": {
              "type": "string",
              "maxLength": 80
            },
            "source_mode": {
              "type": "string",
              "enum": ["jd", "commits", "mixed"]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "mode": {
              "type": "string",
              "enum": ["balanced", "technical", "project", "behavioral", "system-design"]
            },
            "questions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": ["基础", "进阶", "挑战"]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 600
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "answer_points": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "follow_ups": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                },
                "required": ["category", "difficulty", "question", "why", "evidence_refs"],
                "additionalProperties": false
              }
            }
          },
          "required": ["source_mode", "title", "mode", "questions"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_preparation_plan",
        "description": "Create or replace the candidate's evidence-grounded preparation plan, classifying profile, evidence, and real skill gaps and adding a learning roadmap only for skill gaps.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "trace_id": {
              "description": "Exact opaque Panel Trace ID from the submitted prompt.",
              "type": "string",
              "maxLength": 100
            },
            "job_id": {
              "type": "string",
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "strengths": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "maxLength": 500
              }
            },
            "gaps": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "area": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["profile", "evidence", "skill"]
                  },
                  "evidence": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "impact": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "priority": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                  },
                  "actions": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "practice": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["area", "kind", "priority", "actions"],
                "additionalProperties": false
              }
            },
            "roadmap": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "phase": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "kind": {
                    "type": "string",
                    "enum": ["foundation", "project", "practice", "validation"]
                  },
                  "duration": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
