{
  "schemaVersion": 2,
  "id": "job-hunt-hq",
  "version": "0.6.0",
  "title": {
    "default": "Job Hunt HQ",
    "en": "Job Hunt HQ",
    "zh-CN": "求职作战室"
  },
  "description": "Bind one CodeShell project and session to a bundled job-hunt Skill, then visualize sourced jobs, company research, tailored resumes, and interview preparation.",
  "entry": "app/index.html",
  "icon": "layout-dashboard",
  "placement": "right-dock",
  "singleton": true,
  "permissions": [
    "context.session",
    "context.workspace",
    "workspace.info",
    "workspace.read",
    "workspace.write",
    "storage",
    "external.open",
    "agent.submitPrompt"
  ],
  "agent": {
    "tools": [
      {
        "name": "get_job_search_context",
        "description": "Read the active CodeShell project binding, target job, saved opportunities, extracted candidate context, current resume, and saved interview question sets.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "save_candidate_context",
        "description": "Save candidate profile, project evidence, and work history extracted from the active CodeShell project's verified files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "role": {
                  "type": "string",
                  "maxLength": 120
                },
                "contact": {
                  "type": "string",
                  "maxLength": 300
                },
                "target": {
                  "type": "string",
                  "maxLength": 500
                },
                "summary": {
                  "type": "string",
                  "maxLength": 3000
                }
              },
              "additionalProperties": false
            },
            "repositories": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "tech": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  }
                },
                "required": ["name", "summary"],
                "additionalProperties": false
              }
            },
            "work_history": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "period": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "achievements": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                },
                "required": ["company", "role"],
                "additionalProperties": false
              }
            }
          },
          "required": ["profile", "repositories", "work_history"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_job_opportunities",
        "description": "Create or enrich structured job opportunities. Save listing-only or partial JD records early, then call again with the same URL to update them as more evidence becomes available.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "source_id": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "employment_type": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "jd_completeness": {
                    "type": "string",
                    "enum": ["full", "partial", "listing_only"]
                  },
                  "verification_notes": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "fetched_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "match": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": ["company", "title"],
                "additionalProperties": false
              }
            }
          },
          "required": ["jobs"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_workflow_progress",
        "description": "Create or update the current session's job-hunt workflow progress so the project-bound panel can visualize long-running work.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "workflow_id": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "enum": ["running", "completed", "partial", "failed"]
            },
            "current_step": {
              "type": "string",
              "enum": ["discover", "verify-jd", "company", "reviews", "interviews", "artifacts"]
            },
            "message": {
              "type": "string",
              "maxLength": 1000
            },
            "steps": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "status": {
                    "type": "string",
                    "enum": ["pending", "running", "completed", "skipped", "failed"]
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "required": ["id", "status"],
                "additionalProperties": false
              }
            }
          },
          "required": ["status", "current_step"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_job_research",
        "description": "Save sourced company facts, public review summaries, interview intelligence, risks, and source records for one saved job.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "company": {
              "type": "object",
              "properties": {
                "official_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "website": {
                  "type": "string",
                  "maxLength": 1000
                },
                "careers_url": {
                  "type": "string",
                  "maxLength": 1000
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 5000
                },
                "industry": {
                  "type": "string",
                  "maxLength": 200
                },
                "stage": {
                  "type": "string",
                  "maxLength": 200
                },
                "size": {
                  "type": "string",
                  "maxLength": 200
                },
                "locations": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "products": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "tech_signals": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "hiring_signals": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              },
              "required": ["official_name", "summary"],
              "additionalProperties": false
            },
            "reviews": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "sentiment": {
                    "type": "string",
                    "enum": ["positive", "mixed", "negative", "unknown"]
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  },
                  "pros": {
                    "type": "array",
                    "maxItems": 15,
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "cons": {
                    "type": "array",
                    "maxItems": 15,
                    "items": {
                      "type": "string",
                      "maxLength": 500
                    }
                  },
                  "confidence": {
                    "type": "string",
                    "enum": ["high", "medium", "low"]
                  }
                },
                "required": ["source", "sentiment", "summary", "confidence"],
                "additionalProperties": false
              }
            },
            "interview_intel": {
              "type": "object",
              "properties": {
                "summary": {
                  "type": "string",
                  "maxLength": 5000
                },
                "process": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                },
                "themes": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "questions": {
                  "type": "array",
                  "maxItems": 30,
                  "items": {
                    "type": "object",
                    "properties": {
                      "question": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 1000
                      },
                      "category": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "origin": {
                        "type": "string",
                        "enum": ["reported", "predicted"]
                      },
                      "source_url": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    },
                    "required": ["question", "origin"],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "risks": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 1000
              }
            },
            "sources": {
              "type": "array",
              "maxItems": 60,
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["official", "job", "review", "interview", "news", "other"]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "publisher": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "accessed_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "notes": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["kind", "title", "url", "accessed_at"],
                "additionalProperties": false
              }
            }
          },
          "required": ["job_id", "company", "reviews", "interview_intel", "risks", "sources"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_interview_question_set",
        "description": "Save a JD-specific interview question set grounded in the candidate's verified repositories and work history.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "mode": {
              "type": "string",
              "enum": ["balanced", "technical", "project", "behavioral", "system-design"]
            },
            "questions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": ["基础", "进阶", "挑战"]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 600
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "answer_points": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "follow_ups": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                },
                "required": ["category", "difficulty", "question", "why"],
                "additionalProperties": false
              }
            }
          },
          "required": ["job_id", "title", "mode", "questions"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_resume_draft",
        "description": "Save an Agent-written Markdown resume draft for the selected job so the user can continue editing it in the panel.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "markdown": {
              "type": "string",
              "minLength": 80,
              "maxLength": 50000
            },
            "notes": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          "required": ["job_id", "title", "markdown"],
          "additionalProperties": false
        },
        "readOnly": false
      }
    ],
    "skills": ["agent/skills/job-hunt-workflow/SKILL.md"]
  }
}
