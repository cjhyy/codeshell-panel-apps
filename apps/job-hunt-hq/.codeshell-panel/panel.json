{
  "schemaVersion": 2,
  "id": "job-hunt-hq",
  "version": "0.4.0",
  "title": {
    "default": "Job Hunt HQ",
    "en": "Job Hunt HQ",
    "zh-CN": "求职作战室"
  },
  "description": "Visualize jobs, full JDs, tailored resumes, and interview questions generated from the active CodeShell project's CODESHELL.md and verified project files.",
  "entry": "app/index.html",
  "icon": "layout-dashboard",
  "placement": "right-dock",
  "singleton": true,
  "permissions": [
    "context.session",
    "context.workspace",
    "workspace.info",
    "workspace.read",
    "workspace.write",
    "storage",
    "external.open",
    "agent.submitPrompt"
  ],
  "agent": {
    "tools": [
      {
        "name": "get_job_search_context",
        "description": "Read the active CodeShell project binding, target job, saved opportunities, extracted candidate context, current resume, and saved interview question sets.",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "readOnly": true
      },
      {
        "name": "save_candidate_context",
        "description": "Save candidate profile, project evidence, and work history extracted from the active CodeShell project's verified files.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "profile": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 100
                },
                "role": {
                  "type": "string",
                  "maxLength": 120
                },
                "contact": {
                  "type": "string",
                  "maxLength": 300
                },
                "target": {
                  "type": "string",
                  "maxLength": 500
                },
                "summary": {
                  "type": "string",
                  "maxLength": 3000
                }
              },
              "additionalProperties": false
            },
            "repositories": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "path": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "tech": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 3000
                  }
                },
                "required": ["name", "summary"],
                "additionalProperties": false
              }
            },
            "work_history": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "period": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "achievements": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                },
                "required": ["company", "role"],
                "additionalProperties": false
              }
            }
          },
          "required": ["profile", "repositories", "work_history"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_job_opportunities",
        "description": "Save structured job opportunities found by the Agent into the job-search board.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "jobs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "type": "object",
                "properties": {
                  "company": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "location": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "salary": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "source": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "source_id": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "url": {
                    "type": "string",
                    "maxLength": 1000
                  },
                  "published_at": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "employment_type": {
                    "type": "string",
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "match": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": ["company", "title", "description"],
                "additionalProperties": false
              }
            }
          },
          "required": ["jobs"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_interview_question_set",
        "description": "Save a JD-specific interview question set grounded in the candidate's verified repositories and work history.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "mode": {
              "type": "string",
              "enum": ["balanced", "technical", "project", "behavioral", "system-design"]
            },
            "questions": {
              "type": "array",
              "minItems": 3,
              "maxItems": 30,
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "difficulty": {
                    "type": "string",
                    "enum": ["基础", "进阶", "挑战"]
                  },
                  "question": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 600
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 600
                  },
                  "evidence_refs": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "answer_points": {
                    "type": "array",
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "follow_ups": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                },
                "required": ["category", "difficulty", "question", "why"],
                "additionalProperties": false
              }
            }
          },
          "required": ["job_id", "title", "mode", "questions"],
          "additionalProperties": false
        },
        "readOnly": false
      },
      {
        "name": "save_resume_draft",
        "description": "Save an Agent-written Markdown resume draft for the selected job so the user can continue editing it in the panel.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "job_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "markdown": {
              "type": "string",
              "minLength": 80,
              "maxLength": 50000
            },
            "notes": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          },
          "required": ["job_id", "title", "markdown"],
          "additionalProperties": false
        },
        "readOnly": false
      }
    ],
    "skills": ["agent/skills/job-tailor/SKILL.md"]
  }
}
