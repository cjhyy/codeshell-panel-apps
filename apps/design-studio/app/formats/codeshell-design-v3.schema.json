{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeshell.dev/schemas/codeshell-design-v3.schema.json",
  "title": "CodeShell Design v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "canvas", "tokens", "activePageId", "pages"],
  "properties": {
    "format": { "const": "codeshell.design" },
    "version": { "const": 3 },
    "name": { "type": "string", "maxLength": 120 },
    "canvas": { "$ref": "#/$defs/canvas" },
    "tokens": { "$ref": "#/$defs/tokens" },
    "activePageId": { "$ref": "#/$defs/pageId" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "color": {
      "type": "string",
      "pattern": "^(transparent|#[0-9a-fA-F]{6})$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "number", "minimum": 100, "maximum": 10000 },
        "height": { "type": "number", "minimum": 100, "maximum": 10000 },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 80 },
              "value": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "x",
        "y",
        "width",
        "height",
        "fill",
        "stroke",
        "strokeWidth",
        "opacity",
        "rotation",
        "cornerRadius",
        "visible",
        "locked"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": [
            "frame",
            "group",
            "component",
            "instance",
            "rectangle",
            "ellipse",
            "text"
          ]
        },
        "name": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 2000 },
        "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 20000 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 20000 },
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 100 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 9999 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "clipContent": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 4000 },
        "fontSize": { "type": "number", "minimum": 6, "maximum": 240 },
        "fontWeight": { "enum": [400, 500, 600, 700] },
        "lineHeight": { "type": "number", "minimum": 0.7, "maximum": 3 },
        "textAlign": { "enum": ["left", "center", "right"] },
        "layout": { "enum": ["none", "horizontal", "vertical"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 2000 },
        "padding": { "type": "number", "minimum": 0, "maximum": 2000 },
        "alignItems": { "enum": ["start", "center", "end", "stretch"] },
        "justifyContent": { "enum": ["start", "center", "end", "space-between"] },
        "layoutGrow": { "enum": [0, 1] },
        "layoutAlign": { "enum": ["auto", "start", "center", "end", "stretch"] },
        "componentId": { "$ref": "#/$defs/nodeId" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["frame", "group", "component"] } },
            "required": ["type"]
          },
          "then": {
            "required": [
              "layout",
              "gap",
              "padding",
              "alignItems",
              "justifyContent",
              "children"
            ]
          },
          "else": { "not": { "required": ["children"] } }
        },
        {
          "if": {
            "properties": { "type": { "const": "text" } },
            "required": ["type"]
          },
          "then": {
            "required": ["text", "fontSize", "fontWeight", "lineHeight", "textAlign"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "instance" } },
            "required": ["type"]
          },
          "then": { "required": ["componentId"] }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/pageId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}
