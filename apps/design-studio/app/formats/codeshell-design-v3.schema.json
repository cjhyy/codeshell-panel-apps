{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeshell.dev/schemas/codeshell-design-v3.schema.json",
  "title": "CodeShell Design v3",
  "description": "Repository source schema. Runtime semantic validation additionally enforces globally unique node ids, valid acyclic component references, at most 16 nested instance levels, and at most 10,000 expanded render layers per page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "canvas", "tokens", "activePageId", "pages"],
  "properties": {
    "format": { "const": "codeshell.design" },
    "version": { "const": 3 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "canvas": { "$ref": "#/$defs/canvas" },
    "tokens": { "$ref": "#/$defs/tokens" },
    "resources": {
      "type": "array",
      "maxItems": 2048,
      "items": { "$ref": "#/$defs/resource" }
    },
    "activePageId": { "$ref": "#/$defs/pageId" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^(transparent|#[0-9a-fA-F]{6})$"
    },
    "paintColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "paintOpacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "paintPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    },
    "paintStop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "color", "opacity"],
      "properties": {
        "position": {
          "$ref": "#/$defs/paintOpacity"
        },
        "color": {
          "$ref": "#/$defs/paintColor"
        },
        "opacity": {
          "$ref": "#/$defs/paintOpacity"
        }
      }
    },
    "solidPaint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color", "opacity"],
      "properties": {
        "type": {
          "const": "SOLID"
        },
        "color": {
          "$ref": "#/$defs/paintColor"
        },
        "opacity": {
          "$ref": "#/$defs/paintOpacity"
        }
      }
    },
    "linearGradientPaint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "opacity", "handles", "stops"],
      "properties": {
        "type": {
          "const": "GRADIENT_LINEAR"
        },
        "opacity": {
          "$ref": "#/$defs/paintOpacity"
        },
        "handles": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/paintPoint"
          }
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/paintStop"
          }
        },
        "cssLinear": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "direction",
            "positions"
          ],
          "properties": {
            "direction": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "angle"
                  ],
                  "properties": {
                    "angle": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 360
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "corner"
                  ],
                  "properties": {
                    "corner": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "enum": [
                          -1,
                          1
                        ]
                      }
                    }
                  }
                }
              ]
            },
            "positions": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "items": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "const": "previous"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "unit",
                      "value"
                    ],
                    "properties": {
                      "unit": {
                        "enum": [
                          "px",
                          "percent"
                        ]
                      },
                      "value": {
                        "type": "number",
                        "minimum": -20000,
                        "maximum": 20000
                      }
                    }
                  }
                ]
              }
            },
            "sourceOnly": {
              "const": true
            }
          }
        }
      }
    },
    "fillPaints": {
      "type": "array",
      "description": "Editable Figma paints in bottom-to-top order. Runtime additionally validates increasing gradient stop positions and invertible handle geometry.",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/solidPaint"
          },
          {
            "$ref": "#/$defs/linearGradientPaint"
          }
        ]
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "number", "minimum": 100, "maximum": 20000 },
        "height": { "type": "number", "minimum": 100, "maximum": 20000 },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Named document color literals. Design Studio propagates same-name token value edits through matching painted colors.",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "mime", "bytes", "sha256", "partCount"],
      "properties": {
        "id": { "$ref": "#/$defs/pageId" },
        "kind": { "enum": ["image", "font"] },
        "mime": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "partCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "style": { "enum": ["normal", "italic", "oblique"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "font" } },
            "required": ["kind"]
          },
          "then": { "required": ["family", "weight", "style"] },
          "else": {
            "allOf": [
              { "not": { "required": ["family"] } },
              { "not": { "required": ["weight"] } },
              { "not": { "required": ["style"] } }
            ]
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "x",
        "y",
        "width",
        "height",
        "fill",
        "stroke",
        "strokeWidth",
        "opacity",
        "rotation",
        "cornerRadius",
        "visible",
        "locked"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": [
            "frame",
            "group",
            "component",
            "instance",
            "rectangle",
            "ellipse",
            "text",
            "image"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "effectClipping": { "enum": ["intentional"] },
        "contentClipping": { "enum": ["intentional"] },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "opacity", "x", "y", "blur"],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "x": { "type": "number", "minimum": -500, "maximum": 500 },
            "y": { "type": "number", "minimum": -500, "maximum": 500 },
            "blur": { "type": "number", "minimum": 0, "maximum": 200 }
          }
        },
        "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "width": { "type": "number", "minimum": 1, "maximum": 20000 },
        "height": { "type": "number", "minimum": 1, "maximum": 20000 },
        "fill": { "$ref": "#/$defs/color" },
        "fillPaints": { "$ref": "#/$defs/fillPaints" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 100 },
        "strokeAlign": {"enum":["inside","center","outside"]},
        "strokeLayoutExcluded": { "const": true },
        "strokeSides": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["width","color","opacity"],"properties":{"width":{"type":"number","minimum":0,"maximum":100},"color":{"type":"string","pattern":"^#[a-fA-F0-9]{6}$"},"opacity":{"type":"number","minimum":0,"maximum":1}}}},
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 9999 },
        "cornerRadii": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": 0, "maximum": 9999 } },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "clipContent": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 4000 },
        "fontSize": { "type": "number", "minimum": 6, "maximum": 240 },
        "fontWeight": { "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "fontStyle": { "enum": ["normal", "italic"] },
        "lineHeight": { "type": "number", "minimum": 0.7, "maximum": 720 },
        "lineHeightUnit": { "const": "pixels" },
        "letterSpacing": { "type": "number", "minimum": -20, "maximum": 100 },
        "textDecoration": { "enum": ["none", "underline", "line-through"] },
        "textMeasurement": { "enum": ["browser"] },
        "textMetrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "signature",
            "lineWidths",
            "lineInkBounds",
            "height",
            "fontAvailable"
          ],
          "properties": {
            "version": { "const": 1 },
            "signature": { "type": "string", "maxLength": 8500 },
            "sourceSignature": { "type": "string", "maxLength": 8500 },
            "lineWidths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4001,
              "items": { "type": "number", "minimum": 0, "maximum": 1000000 }
            },
            "lineInkBounds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4001,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y", "width", "height"],
                "properties": {
                  "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
                  "width": { "type": "number", "minimum": 0, "maximum": 1000000 },
                  "height": { "type": "number", "minimum": 0, "maximum": 1000000 }
                }
              }
            },
            "height": { "type": "number", "minimum": 0, "maximum": 1000000 },
            "fontAvailable": { "type": "boolean" }
          }
        },
        "textSource": { "type": "string", "maxLength": 4000 },
        "textFlow": { "enum": ["wrap"] },
        "textOverflow": { "enum": ["ellipsis"] },
        "textFlowWidth": { "type": "number", "minimum": 1, "maximum": 20000 },
        "layoutBaselineSource": { "const": "native" },
        "layoutBaselineOffset": { "type": "number", "minimum": -100, "maximum": 100 },
        "fontRef": { "$ref": "#/$defs/pageId" },
        "textAlign": { "enum": ["left", "center", "right"] },
        "imageRef": { "$ref": "#/$defs/pageId" },
        "objectFit": { "enum": ["fill", "contain", "cover"] },
        "layout": { "enum": ["none", "horizontal", "vertical", "grid"] },
        "layoutWrap": { "enum": ["none", "wrap", "wrap-reverse"] },
        "layoutReverse": { "type": "boolean" },
        "gap": { "type": "number", "minimum": -2000, "maximum": 2000 },
        "rowGap": { "type": "number", "minimum": -2000, "maximum": 2000 },
        "columnGap": { "type": "number", "minimum": -2000, "maximum": 2000 },
        "padding": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingTop": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingRight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingBottom": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingLeft": { "type": "number", "minimum": 0, "maximum": 2000 },
        "alignItems": { "enum": ["start", "center", "end", "stretch", "baseline"] },
        "justifyContent": { "enum": ["start", "center", "end", "space-between"] },
        "alignContent": { "enum": ["start", "center", "end", "space-between", "stretch"] },
        "gridRows": {"type": "integer", "minimum": 1, "maximum": 24},
        "gridColumnSizes": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["fixed", "flex", "hug"]}, "value": {"type": "number", "minimum": 0, "maximum": 20000}}, "allOf": [{"if": {"properties": {"type": {"const": "fixed"}}}, "then": {"required": ["value"]}}, {"if": {"properties": {"type": {"const": "flex"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0}}}}, {"if": {"properties": {"type": {"const": "hug"}}}, "then": {"not": {"required": ["value"]}}}]}},
        "gridRowSizes": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "object", "additionalProperties": false, "required": ["type"], "properties": {"type": {"enum": ["fixed", "flex", "hug"]}, "value": {"type": "number", "minimum": 0, "maximum": 20000}}, "allOf": [{"if": {"properties": {"type": {"const": "fixed"}}}, "then": {"required": ["value"]}}, {"if": {"properties": {"type": {"const": "flex"}}}, "then": {"properties": {"value": {"exclusiveMinimum": 0}}}}, {"if": {"properties": {"type": {"const": "hug"}}}, "then": {"not": {"required": ["value"]}}}]}},
        "gridItemsPositioning": {"enum": ["manual", "row-auto-flow"]},
        "gridAutoTracks": {"enum": ["none", "rows"]},
        "gridRowAnchorIndex": {"type": "integer", "minimum": 0, "maximum": 9999},
        "gridColumnAnchorIndex": {"type": "integer", "minimum": 0, "maximum": 9999},
        "gridChildHorizontalAlign": {"enum": ["auto", "start", "center", "end"]},
        "gridChildVerticalAlign": {"enum": ["auto", "start", "center", "end"]},
        "gridColumns": { "type": "integer", "minimum": 1, "maximum": 24 },
        "minWidth": { "type": "number", "minimum": 1, "maximum": 20000 },
        "maxWidth": { "type": "number", "minimum": 1, "maximum": 20000 },
        "minHeight": { "type": "number", "minimum": 1, "maximum": 20000 },
        "maxHeight": { "type": "number", "minimum": 1, "maximum": 20000 },
        "layoutSizingHorizontal": { "enum": ["fixed", "hug", "fill"] },
        "layoutSizingVertical": { "enum": ["fixed", "hug", "fill"] },
        "layoutPositioning": { "enum": ["auto", "absolute"] },
        "layoutAlignSelf": {
          "enum": ["auto", "start", "center", "end", "stretch", "baseline"]
        },
        "layoutMarginBefore": { "enum": ["auto"] },
        "gridColumnSpan": { "type": "integer", "minimum": 1, "maximum": 24 },
        "gridRowSpan": { "type": "integer", "minimum": 1, "maximum": 24 },
        "constraintHorizontal": { "enum": ["start", "center", "end", "stretch", "scale"] },
        "constraintVertical": { "enum": ["start", "center", "end", "stretch", "scale"] },
        "constraintBaseWidth": { "type": "number", "minimum": 1, "maximum": 20000 },
        "constraintBaseHeight": { "type": "number", "minimum": 1, "maximum": 20000 },
        "constraintLeft": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "constraintRight": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "constraintTop": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "constraintBottom": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "componentId": { "$ref": "#/$defs/nodeId" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        { "if": { "required": ["cornerRadii"] }, "then": { "properties": { "type": { "enum": ["frame", "rectangle", "component", "image"] } } } },
        { "if": { "required": ["strokeLayoutExcluded"] }, "then": { "required": ["layout", "strokeAlign"], "properties": { "type": { "enum": ["frame", "component"] }, "layout": { "enum": ["horizontal", "vertical"] }, "strokeAlign": { "const": "inside" } } } },
        { "if": { "anyOf": [{"required":["strokeSides"]},{"required":["strokeAlign"]}] }, "then": { "properties": { "type": { "enum": ["frame", "rectangle", "component"] } } } },
        {
          "if": {
            "properties": {
              "type": {
                "enum": ["group", "instance", "image"]
              }
            },
            "required": ["type"]
          },
          "then": {
            "not": {
              "required": ["fillPaints"]
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "gap"
                ],
                "properties": {
                  "gap": {
                    "exclusiveMaximum": 0
                  }
                }
              },
              {
                "required": [
                  "rowGap"
                ],
                "properties": {
                  "rowGap": {
                    "exclusiveMaximum": 0
                  }
                }
              },
              {
                "required": [
                  "columnGap"
                ],
                "properties": {
                  "columnGap": {
                    "exclusiveMaximum": 0
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "layout": {
                "enum": [
                  "horizontal",
                  "vertical"
                ]
              },
              "layoutWrap": {
                "const": "none"
              },
              "layoutReverse": {
                "const": false
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "layout": {
                      "const": "horizontal"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "rowGap": {
                      "minimum": 0
                    },
                    "layoutSizingHorizontal": {
                      "enum": [
                        "fixed",
                        "fill"
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "columnGap": {
                      "minimum": 0
                    },
                    "layoutSizingVertical": {
                      "enum": [
                        "fixed",
                        "fill"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["frame", "group", "component"] } },
            "required": ["type"]
          },
          "then": {
            "required": ["layout", "gap", "padding", "alignItems", "justifyContent", "children"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["children"] },
                { "required": ["layout"] },
                { "required": ["layoutWrap"] },
                { "required": ["layoutReverse"] },
                { "required": ["gap"] },
                { "required": ["rowGap"] },
                { "required": ["columnGap"] },
                { "required": ["padding"] },
                { "required": ["paddingTop"] },
                { "required": ["paddingRight"] },
                { "required": ["paddingBottom"] },
                { "required": ["paddingLeft"] },
                { "required": ["alignItems"] },
                { "required": ["justifyContent"] },
                { "required": ["alignContent"] },
                { "required": ["gridColumns"] },
                { "required": ["gridRows"] },
                { "required": ["gridColumnSizes"] },
                { "required": ["gridRowSizes"] },
                { "required": ["gridItemsPositioning"] },
                { "required": ["gridAutoTracks"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "text" } },
            "required": ["type"]
          },
          "then": {
            "required": ["text", "fontSize", "fontWeight", "lineHeight", "textAlign"],
            "properties": { "cornerRadius": { "const": 0 } },
            "allOf": [{
              "if": { "required": ["lineHeightUnit"] },
              "then": { "properties": { "lineHeight": { "minimum": 4.2, "maximum": 720 } } },
              "else": { "properties": { "lineHeight": { "minimum": 0.7, "maximum": 3 } } }
            }]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["text"] },
                { "required": ["fontSize"] },
                { "required": ["fontWeight"] },
                { "required": ["fontFamily"] },
                { "required": ["fontStyle"] },
                { "required": ["lineHeight"] },
                { "required": ["lineHeightUnit"] },
                { "required": ["letterSpacing"] },
                { "required": ["textDecoration"] },
                { "required": ["textMeasurement"] },
                { "required": ["textMetrics"] },
                { "required": ["textSource"] },
                { "required": ["textFlow"] },
                { "required": ["textOverflow"] },
                { "required": ["textFlowWidth"] },
                { "required": ["layoutBaselineOffset"] },
                { "required": ["layoutBaselineSource"] },
                { "required": ["fontRef"] },
                { "required": ["textAlign"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "image" } },
            "required": ["type"]
          },
          "then": { "required": ["imageRef", "objectFit"] },
          "else": {
            "allOf": [
              { "not": { "required": ["imageRef"] } },
              { "not": { "required": ["objectFit"] } }
            ]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "instance" } },
            "required": ["type"]
          },
          "then": { "required": ["componentId"] },
          "else": { "not": { "required": ["componentId"] } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["frame", "component"] } },
            "required": ["type"]
          },
          "else": {
            "allOf": [
              { "not": { "required": ["clipContent"] } },
              { "not": { "required": ["contentClipping"] } }
            ]
          }
        },
        {
          "if": { "required": ["contentClipping"] },
          "then": {
            "properties": { "clipContent": { "const": true } },
            "required": ["clipContent"]
          }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["group", "instance"] } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "fill": { "const": "transparent" },
              "stroke": { "const": "transparent" },
              "strokeWidth": { "const": 0 },
              "cornerRadius": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "group" } },
            "required": ["type"]
          },
          "then": { "not": { "required": ["shadow"] } }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/pageId" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}
