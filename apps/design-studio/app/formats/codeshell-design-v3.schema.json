{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codeshell.dev/schemas/codeshell-design-v3.schema.json",
  "title": "CodeShell Design v3",
  "description": "Repository source schema. Runtime semantic validation additionally enforces globally unique node ids, valid acyclic component references, at most 16 nested instance levels, and at most 10,000 expanded render layers per page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "canvas", "tokens", "activePageId", "pages"],
  "properties": {
    "format": { "const": "codeshell.design" },
    "version": { "const": 3 },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "canvas": { "$ref": "#/$defs/canvas" },
    "tokens": { "$ref": "#/$defs/tokens" },
    "activePageId": { "$ref": "#/$defs/pageId" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "pageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "color": {
      "type": "string",
      "pattern": "^(transparent|#[0-9a-fA-F]{6})$"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "type": "number", "minimum": 100, "maximum": 10000 },
        "height": { "type": "number", "minimum": 100, "maximum": 10000 },
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "tokens": {
      "type": "object",
      "description": "Named document color literals. Design Studio propagates same-name token value edits through matching painted colors.",
      "additionalProperties": false,
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
              },
              "value": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "x",
        "y",
        "width",
        "height",
        "fill",
        "stroke",
        "strokeWidth",
        "opacity",
        "rotation",
        "cornerRadius",
        "visible",
        "locked"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "type": {
          "enum": ["frame", "group", "component", "instance", "rectangle", "ellipse", "text"]
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
        },
        "notes": { "type": "string", "maxLength": 2000 },
        "effectClipping": { "enum": ["intentional"] },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["color", "opacity", "x", "y", "blur"],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "x": { "type": "number", "minimum": -500, "maximum": 500 },
            "y": { "type": "number", "minimum": -500, "maximum": 500 },
            "blur": { "type": "number", "minimum": 0, "maximum": 200 }
          }
        },
        "x": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "y": { "type": "number", "minimum": -20000, "maximum": 20000 },
        "width": { "type": "number", "minimum": 1, "maximum": 20000 },
        "height": { "type": "number", "minimum": 1, "maximum": 20000 },
        "fill": { "$ref": "#/$defs/color" },
        "stroke": { "$ref": "#/$defs/color" },
        "strokeWidth": { "type": "number", "minimum": 0, "maximum": 100 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
        "cornerRadius": { "type": "number", "minimum": 0, "maximum": 9999 },
        "visible": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "clipContent": { "type": "boolean" },
        "text": { "type": "string", "maxLength": 4000 },
        "fontSize": { "type": "number", "minimum": 6, "maximum": 240 },
        "fontWeight": { "enum": [100, 200, 300, 400, 500, 600, 700, 800, 900] },
        "fontFamily": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "fontStyle": { "enum": ["normal", "italic"] },
        "lineHeight": { "type": "number", "minimum": 0.7, "maximum": 3 },
        "letterSpacing": { "type": "number", "minimum": -20, "maximum": 100 },
        "textDecoration": { "enum": ["none", "underline", "line-through"] },
        "textMeasurement": { "enum": ["browser"] },
        "textAlign": { "enum": ["left", "center", "right"] },
        "layout": { "enum": ["none", "horizontal", "vertical", "grid"] },
        "layoutWrap": { "enum": ["none", "wrap"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 2000 },
        "rowGap": { "type": "number", "minimum": 0, "maximum": 2000 },
        "columnGap": { "type": "number", "minimum": 0, "maximum": 2000 },
        "padding": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingTop": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingRight": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingBottom": { "type": "number", "minimum": 0, "maximum": 2000 },
        "paddingLeft": { "type": "number", "minimum": 0, "maximum": 2000 },
        "alignItems": { "enum": ["start", "center", "end", "stretch"] },
        "justifyContent": { "enum": ["start", "center", "end", "space-between"] },
        "alignContent": { "enum": ["start", "center", "end", "space-between", "stretch"] },
        "gridColumns": { "type": "integer", "minimum": 1, "maximum": 24 },
        "layoutSizingHorizontal": { "enum": ["fixed", "hug", "fill"] },
        "layoutSizingVertical": { "enum": ["fixed", "hug", "fill"] },
        "layoutPositioning": { "enum": ["auto", "absolute"] },
        "gridColumnSpan": { "type": "integer", "minimum": 1, "maximum": 24 },
        "gridRowSpan": { "type": "integer", "minimum": 1, "maximum": 24 },
        "layoutGrow": { "enum": [0, 1] },
        "layoutAlign": { "enum": ["auto", "start", "center", "end", "stretch"] },
        "componentId": { "$ref": "#/$defs/nodeId" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "enum": ["frame", "group", "component"] } },
            "required": ["type"]
          },
          "then": {
            "required": ["layout", "gap", "padding", "alignItems", "justifyContent", "children"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["children"] },
                { "required": ["layout"] },
                { "required": ["layoutWrap"] },
                { "required": ["gap"] },
                { "required": ["rowGap"] },
                { "required": ["columnGap"] },
                { "required": ["padding"] },
                { "required": ["paddingTop"] },
                { "required": ["paddingRight"] },
                { "required": ["paddingBottom"] },
                { "required": ["paddingLeft"] },
                { "required": ["alignItems"] },
                { "required": ["justifyContent"] },
                { "required": ["alignContent"] },
                { "required": ["gridColumns"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "text" } },
            "required": ["type"]
          },
          "then": {
            "required": ["text", "fontSize", "fontWeight", "lineHeight", "textAlign"],
            "properties": { "cornerRadius": { "const": 0 } }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["text"] },
                { "required": ["fontSize"] },
                { "required": ["fontWeight"] },
                { "required": ["fontFamily"] },
                { "required": ["fontStyle"] },
                { "required": ["lineHeight"] },
                { "required": ["letterSpacing"] },
                { "required": ["textDecoration"] },
                { "required": ["textMeasurement"] },
                { "required": ["textAlign"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "instance" } },
            "required": ["type"]
          },
          "then": { "required": ["componentId"] },
          "else": { "not": { "required": ["componentId"] } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["frame", "component"] } },
            "required": ["type"]
          },
          "else": { "not": { "required": ["clipContent"] } }
        },
        {
          "if": {
            "properties": { "type": { "enum": ["group", "instance"] } },
            "required": ["type"]
          },
          "then": {
            "properties": {
              "fill": { "const": "transparent" },
              "stroke": { "const": "transparent" },
              "strokeWidth": { "const": 0 },
              "cornerRadius": { "const": 0 }
            }
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "group" } },
            "required": ["type"]
          },
          "then": { "not": { "required": ["shadow"] } }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/pageId" },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      }
    }
  }
}
