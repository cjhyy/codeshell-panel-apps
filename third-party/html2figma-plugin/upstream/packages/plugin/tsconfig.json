{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@html2figma/shared": ["../shared"],
      "@html2figma/figma": ["../figma"],
      "@html2figma/figma/*": ["../figma/*"]
    }
  },
  "include": [
    "**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "ui"
  ]
}
